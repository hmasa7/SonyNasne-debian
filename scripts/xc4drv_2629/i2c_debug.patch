diff -ru a/kdrv/drv/i2c.c b/kdrv/drv/i2c.c
--- a/kdrv/drv/i2c.c
+++ b/kdrv/drv/i2c.c
@@ -22,6 +22,119 @@
 *******************************************************************************/
 
 #include "devcontext.h"
+#ifdef LINUX
+#include <linux/sched.h>
+#include <linux/jiffies.h>
+/* Debug (dbg_i2c=1): I2C requests (MCU etc.) that never complete and leave the caller asleep in D state.
+ * Keep the last XC_I2C_TR_N I2C events of each block in its own ring (block 1 = tuners is busy and would push
+ * block 0 = MCU out of a shared ring), count interrupts/completions/errors per block, and dump them with the
+ * queue state and the I2C/interrupt registers when a request is stuck. Transfers slower than XC_I2C_SLOW_MS are
+ * printed as they complete (rate limited). */
+extern int dbg_i2c;
+#define XC_I2C_TR_N 64
+#define XC_I2C_SLOW_MS 100
+static struct { unsigned long j; int pid; unsigned char ev; unsigned int a, b; } xc_i2c_tr[I2CBLOCKMAX][XC_I2C_TR_N];
+static unsigned int xc_i2c_tr_pos[I2CBLOCKMAX];
+static struct { unsigned long start_j, last_done_j, isr, done, hwerr, cmderr, spurious, slow, max_ms, pinmux, unlock_busy; } xc_i2c_st[I2CBLOCKMAX];
+static const char *xc_i2c_ev_name[] = { "?", "start", "queued", "waited", "complete", "next", "callback", "timer",
+                                        "pre", "isr", "pinmux", "unlock", "cmdreg" };
+#define XC_I2C_EV_N (sizeof(xc_i2c_ev_name) / sizeof(xc_i2c_ev_name[0]))
+static void xc_i2c_tr_add(int ev, int blk, unsigned int a, unsigned int b)
+{
+    unsigned int i;
+    if (blk < 0 || blk >= I2CBLOCKMAX) return;
+    i = xc_i2c_tr_pos[blk]++ % XC_I2C_TR_N;
+    xc_i2c_tr[blk][i].j = jiffies; xc_i2c_tr[blk][i].pid = current->pid; xc_i2c_tr[blk][i].ev = ev;
+    xc_i2c_tr[blk][i].a = a; xc_i2c_tr[blk][i].b = b;
+}
+#define XC_I2C_TR(ev, blk, a, b) do { if (dbg_i2c) xc_i2c_tr_add(ev, blk, (unsigned int)(a), (unsigned int)(b)); } while (0)
+static void xc_i2c_dbg_start(PXCODEDEV pXcode, uint32 blk)      /* before the command register is written */
+{
+    uint32 cmd = 0, mtx = 0;
+    if (!dbg_i2c) return;
+    MMR_READ_CHECK(pXcode, &cmd, pXcode->ProcI2cComQueue[blk].i2c_reg_offsets.command_reg_offset);
+    MMR_READ_CHECK(pXcode, &mtx, XC_I2C_HW_MUTEX);
+    xc_i2c_st[blk].start_j = jiffies;
+    xc_i2c_tr_add(8, blk, cmd, mtx);
+}
+static void xc_i2c_dbg_done(uint32 blk, uint32 completed, uint32 cmd, uint32 slave)   /* completion seen in the DPC */
+{
+    unsigned long ms;
+    if (!dbg_i2c) return;
+    ms = (jiffies - xc_i2c_st[blk].start_j) * 1000 / HZ;
+    xc_i2c_st[blk].done++; xc_i2c_st[blk].last_done_j = jiffies;
+    if (completed == IOCTL_RET_CMD_FAIL_HW_ERROR) xc_i2c_st[blk].hwerr++;
+    if (cmd & XC_I2C0_COMMAND_ERROR_MASK) xc_i2c_st[blk].cmderr++;
+    if (ms > xc_i2c_st[blk].max_ms) xc_i2c_st[blk].max_ms = ms;
+    xc_i2c_tr_add(12, blk, cmd, ms);
+    if (ms >= XC_I2C_SLOW_MS) {
+        xc_i2c_st[blk].slow++;
+        if (printk_ratelimit())
+            printk(KERN_WARNING "xc_i2c_dbg: slow block %u slave %02x %lu ms completed %d cmdreg %08x\n", blk, slave, ms, (int)completed, cmd);
+    }
+}
+static void xc_i2c_dbg_isr(PXCODEDEV pXcode, uint32 blk, uint32 st)   /* this block's bits are set in PPC_INT_STATUS */
+{
+    if (!dbg_i2c) return;
+    xc_i2c_st[blk].isr++;
+    if (pXcode->ProcI2cComQueue[blk].pcurrent_i2c_data_com == NULL) xc_i2c_st[blk].spurious++;
+    xc_i2c_tr_add(9, blk, st, pXcode->ProcI2cComQueue[blk].pcurrent_i2c_data_com != NULL);
+}
+static void xc_i2c_dbg_unlock(PXCODEDEV pXcode, uint32 mtx)           /* the HW mutex is released while a transfer is still running */
+{
+    uint32 b;
+    if (!dbg_i2c) return;
+    for (b = 0; b < I2CBLOCKMAX; b++)
+        if (pXcode->ProcI2cComQueue[b].pcurrent_i2c_data_com != NULL) {
+            xc_i2c_st[b].unlock_busy++;
+            xc_i2c_tr_add(11, b, mtx, pXcode->ProcI2cComQueue[b].current_completed);
+        }
+}
+void xc_i2c_dbg_report(PXCODEDEV pXcode, void *pioctl, unsigned long secs)
+{
+    static const struct { const char *name; uint32 off; } regs[] = {
+        { "PPC_INT_STATUS", XC_PPC_INT_STATUS }, { "PPC_HOST_INT_MASK", XC_PPC_HOST_INT_MASK },
+        { "MIPS3_INTERRUPT", XC_MIPS3_INTERRUPT }, { "MIPS3_INTERRUPT_MASK", XC_MIPS3_INTERRUPT_MASK },
+        { "I2C_HW_MUTEX", XC_I2C_HW_MUTEX }, { "GPIO_I_CTRL", XC_GPIO_I_CTRL },
+        { "I2C0_CONFIG", XC_I2C0_CONFIG }, { "I2C0_COMMAND", XC_I2C0_COMMAND },
+        { "I2C1_CONFIG", XC_I2C1_CONFIG }, { "I2C1_COMMAND", XC_I2C1_COMMAND },
+    };      /* status/config/command only: the data registers are FIFOs and are not read */
+    uint32 v, b;
+    unsigned int n, k, r;
+    if (pioctl)
+        printk(KERN_WARNING "xc_i2c_dbg: pid %d (%s) I2C request %p not completed after %lu s (semaphore %d)\n",
+               current->pid, current->comm, pioctl, secs, (int)pXcode->i2c_semaphore);
+    else        /* on demand (dbg_i2c_dump): counters and registers only */
+        printk(KERN_WARNING "xc_i2c_dbg: dump (semaphore %d)\n", (int)pXcode->i2c_semaphore);
+    for (r = 0; r < sizeof(regs) / sizeof(regs[0]); r++) {
+        v = 0;
+        MMR_READ_CHECK(pXcode, &v, regs[r].off);
+        printk(KERN_WARNING "xc_i2c_dbg: reg %s (%04x) %08x\n", regs[r].name, (unsigned int)regs[r].off, v);
+    }
+    for (b = 0; b < I2CBLOCKMAX; b++) {
+        printk(KERN_WARNING "xc_i2c_dbg: block %u current %p completed %d head %u tail %u full %u started %lu ms ago, last done %lu ms ago\n", b,
+               pXcode->ProcI2cComQueue[b].pcurrent_i2c_data_com, (int)pXcode->ProcI2cComQueue[b].current_completed,
+               (unsigned int)pXcode->ProcI2cComQueue[b].head, (unsigned int)pXcode->ProcI2cComQueue[b].tail,
+               (unsigned int)pXcode->ProcI2cComQueue[b].full,
+               (jiffies - xc_i2c_st[b].start_j) * 1000 / HZ, (jiffies - xc_i2c_st[b].last_done_j) * 1000 / HZ);
+        printk(KERN_WARNING "xc_i2c_dbg: block %u counts isr %lu done %lu hwerr %lu cmderr %lu spurious %lu slow %lu max %lu ms pinmux %lu unlock_busy %lu\n", b,
+               xc_i2c_st[b].isr, xc_i2c_st[b].done, xc_i2c_st[b].hwerr, xc_i2c_st[b].cmderr, xc_i2c_st[b].spurious,
+               xc_i2c_st[b].slow, xc_i2c_st[b].max_ms, xc_i2c_st[b].pinmux, xc_i2c_st[b].unlock_busy);
+        n = !pioctl ? 0 : xc_i2c_tr_pos[b] < XC_I2C_TR_N ? xc_i2c_tr_pos[b] : XC_I2C_TR_N;
+        for (k = xc_i2c_tr_pos[b] - n; k != xc_i2c_tr_pos[b]; k++) {
+            unsigned int i = k % XC_I2C_TR_N;
+            printk(KERN_WARNING "xc_i2c_dbg: blk %u [-%lu ms] pid %d %s a %x b %x\n", b, (jiffies - xc_i2c_tr[b][i].j) * 1000 / HZ,
+                   xc_i2c_tr[b][i].pid, xc_i2c_tr[b][i].ev < XC_I2C_EV_N ? xc_i2c_ev_name[xc_i2c_tr[b][i].ev] : "?", xc_i2c_tr[b][i].a, xc_i2c_tr[b][i].b);
+        }
+    }
+}
+#else
+#define XC_I2C_TR(ev, blk, a, b) do { } while (0)
+#define xc_i2c_dbg_start(p, b) do { } while (0)
+#define xc_i2c_dbg_done(b, c, r, s) do { } while (0)
+#define xc_i2c_dbg_isr(p, b, s) do { } while (0)
+#define xc_i2c_dbg_unlock(p, m) do { } while (0)
+#endif
 
