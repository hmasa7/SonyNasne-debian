diff -ru a/kdrv/drv/i2c.c b/kdrv/drv/i2c.c
--- a/kdrv/drv/i2c.c
+++ b/kdrv/drv/i2c.c
@@ -22,6 +22,49 @@
 *******************************************************************************/
 
 #include "devcontext.h"
+#ifdef LINUX
+#include <linux/sched.h>
+#include <linux/jiffies.h>
+/* Debug (dbg_i2c=1): I2C requests (MCU etc.) that never complete and leave the caller asleep in D state.
+ * Keep the last XC_I2C_TR_N I2C events in a ring and dump them with the queue state when a request is stuck. */
+extern int dbg_i2c;
+#define XC_I2C_TR_N 128
+static struct { unsigned long j; int pid; unsigned char ev, blk; unsigned int a, b; } xc_i2c_tr[XC_I2C_TR_N];
+static unsigned int xc_i2c_tr_pos;
+static const char *xc_i2c_ev_name[] = { "?", "start", "queued", "waited", "complete", "next", "callback", "timer" };
+static void xc_i2c_tr_add(int ev, int blk, unsigned int a, unsigned int b)
+{
+    unsigned int i = xc_i2c_tr_pos++ % XC_I2C_TR_N;
+    xc_i2c_tr[i].j = jiffies; xc_i2c_tr[i].pid = current->pid; xc_i2c_tr[i].ev = ev; xc_i2c_tr[i].blk = blk;
+    xc_i2c_tr[i].a = a; xc_i2c_tr[i].b = b;
+}
+#define XC_I2C_TR(ev, blk, a, b) do { if (dbg_i2c) xc_i2c_tr_add(ev, blk, (unsigned int)(a), (unsigned int)(b)); } while (0)
+void xc_i2c_dbg_report(PXCODEDEV pXcode, void *pioctl, unsigned long secs)
+{
+    uint32 st = 0, mtx = 0, cmd, b;
+    unsigned int n, k, pos = xc_i2c_tr_pos;
+    printk(KERN_WARNING "xc_i2c_dbg: pid %d (%s) I2C request %p not completed after %lu s\n", current->pid, current->comm, pioctl, secs);
+    MMR_READ_CHECK(pXcode, &st, XC_PPC_INT_STATUS);
+    MMR_READ_CHECK(pXcode, &mtx, XC_I2C_HW_MUTEX);
+    printk(KERN_WARNING "xc_i2c_dbg: PPC_INT_STATUS %08x I2C_HW_MUTEX %08x semaphore %d\n", st, mtx, (int)pXcode->i2c_semaphore);
+    for (b = 0; b < I2CBLOCKMAX; b++) {
+        cmd = 0;
+        MMR_READ_CHECK(pXcode, &cmd, pXcode->ProcI2cComQueue[b].i2c_reg_offsets.command_reg_offset);
+        printk(KERN_WARNING "xc_i2c_dbg: block %u current %p completed %d head %u tail %u full %u cmdreg %08x\n", b,
+               pXcode->ProcI2cComQueue[b].pcurrent_i2c_data_com, (int)pXcode->ProcI2cComQueue[b].current_completed,
+               (unsigned int)pXcode->ProcI2cComQueue[b].head, (unsigned int)pXcode->ProcI2cComQueue[b].tail,
+               (unsigned int)pXcode->ProcI2cComQueue[b].full, cmd);
+    }
+    n = pos < XC_I2C_TR_N ? pos : XC_I2C_TR_N;
+    for (k = pos - n; k != pos; k++) {
+        unsigned int i = k % XC_I2C_TR_N;
+        printk(KERN_WARNING "xc_i2c_dbg: [-%lu ms] pid %d %s blk %u a %x b %x\n", (long)(jiffies - xc_i2c_tr[i].j) * 1000 / HZ,
+               xc_i2c_tr[i].pid, xc_i2c_tr[i].ev < 8 ? xc_i2c_ev_name[xc_i2c_tr[i].ev] : "?", xc_i2c_tr[i].blk, xc_i2c_tr[i].a, xc_i2c_tr[i].b);
+    }
+}
+#else
+#define XC_I2C_TR(ev, blk, a, b) do { } while (0)
+#endif
 
 /* Defines */
 
